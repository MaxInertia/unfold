{
  "//": "Side effects of the standard library and the common libraries, shipped as rules so a repo file can switch any of them off by id or add its own in the same vocabulary. Kinds: db, net, file, env, time, process. Goroutines, channel operations and writes to package-level variables are statement shapes rather than calls, and are detected by the indexer directly.",
  "rules": [
    {"id": "effect.sql.query", "//": "database/sql reads, on DB, Tx, Conn and Stmt alike",
     "match": {"package": "database/sql", "func": "Query*"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.sql.exec",
     "match": {"package": "database/sql", "func": "Exec*"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},
    {"id": "effect.sql.tx", "//": "a transaction is a round trip whichever way it goes",
     "match": {"package": "database/sql", "func": "Begin*"},
     "emit": {"role": "effect", "kind": "db"}},
    {"id": "effect.sql.open",
     "match": {"package": "database/sql", "func": "Open*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "db"}},

    {"id": "effect.pgx.query", "//": "pgx, pgxpool and the v4/v5 module paths",
     "match": {"package": "github.com/jackc/pgx/**", "func": "Query*"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.pgx.exec",
     "match": {"package": "github.com/jackc/pgx/**", "func": "Exec*"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},
    {"id": "effect.pgx.tx",
     "match": {"package": "github.com/jackc/pgx/**", "func": "Begin*"},
     "emit": {"role": "effect", "kind": "db"}},
    {"id": "effect.pgx.copy",
     "match": {"package": "github.com/jackc/pgx/**", "func": "CopyFrom"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},

    {"id": "effect.gorm.find",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Find"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.first",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "First"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.last",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Last"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.take",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Take"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.scan",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Scan"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.count",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Count"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.pluck",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Pluck"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.rows",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Row*"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.gorm.create",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Create*"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},
    {"id": "effect.gorm.save",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Save"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},
    {"id": "effect.gorm.update",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Update*"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},
    {"id": "effect.gorm.delete",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Delete"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},
    {"id": "effect.gorm.exec",
     "match": {"package": "gorm.io/gorm", "recv": "DB", "func": "Exec"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},

    {"id": "effect.sqlx.query",
     "match": {"package": "github.com/jmoiron/sqlx", "func": "*Query*"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.sqlx.get",
     "match": {"package": "github.com/jmoiron/sqlx", "func": "Get*"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.sqlx.select",
     "match": {"package": "github.com/jmoiron/sqlx", "func": "Select*"},
     "emit": {"role": "effect", "kind": "db", "access": "read"}},
    {"id": "effect.sqlx.exec",
     "match": {"package": "github.com/jmoiron/sqlx", "func": "*Exec*"},
     "emit": {"role": "effect", "kind": "db", "access": "write"}},

    {"id": "effect.redis", "//": "every command is a round trip; the client has too many to name, so any method on it counts",
     "match": {"package": "github.com/redis/go-redis/**", "recv": "*Client", "recvOnly": true},
     "emit": {"role": "effect", "kind": "db"}},
    {"id": "effect.redis.legacy",
     "match": {"package": "github.com/go-redis/redis/**", "recv": "*Client", "recvOnly": true},
     "emit": {"role": "effect", "kind": "db"}},

    {"id": "effect.http.get", "//": "funcOnly keeps http.Header.Get out of it",
     "match": {"package": "net/http", "func": "Get", "funcOnly": true},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.http.post",
     "match": {"package": "net/http", "func": "Post*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.http.head",
     "match": {"package": "net/http", "func": "Head", "funcOnly": true},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.http.client.do",
     "match": {"package": "net/http", "recv": "Client", "func": "Do"},
     "emit": {"role": "effect", "kind": "net"}},
    {"id": "effect.http.client.get",
     "match": {"package": "net/http", "recv": "Client", "func": "Get"},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.http.client.post",
     "match": {"package": "net/http", "recv": "Client", "func": "Post*"},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.http.client.head",
     "match": {"package": "net/http", "recv": "Client", "func": "Head"},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.http.serve",
     "match": {"package": "net/http", "func": "ListenAndServe*"},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.net.dial",
     "match": {"package": "net", "func": "Dial*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "net"}},
    {"id": "effect.net.listen",
     "match": {"package": "net", "func": "Listen*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "net"}},
    {"id": "effect.grpc.invoke",
     "match": {"package": "google.golang.org/grpc", "recv": "ClientConn", "func": "Invoke"},
     "emit": {"role": "effect", "kind": "net", "key": "{arg1}"}},
    {"id": "effect.grpc.stream",
     "match": {"package": "google.golang.org/grpc", "recv": "ClientConn", "func": "NewStream"},
     "emit": {"role": "effect", "kind": "net"}},
    {"id": "effect.grpc.dial",
     "match": {"package": "google.golang.org/grpc", "func": "*Dial*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},
    {"id": "effect.grpc.newclient",
     "match": {"package": "google.golang.org/grpc", "func": "NewClient", "funcOnly": true},
     "emit": {"role": "effect", "kind": "net", "key": "{arg0}"}},

    {"id": "effect.os.open",
     "match": {"package": "os", "func": "Open", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg0}"}},
    {"id": "effect.os.openfile", "//": "the flags decide the direction, and they are rarely a literal worth decoding",
     "match": {"package": "os", "func": "OpenFile", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "key": "{arg0}"}},
    {"id": "effect.os.read", "//": "ReadFile, ReadDir, Readlink",
     "match": {"package": "os", "func": "Read*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg0}"}},
    {"id": "effect.os.stat",
     "match": {"package": "os", "func": "*Stat", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg0}"}},
    {"id": "effect.os.create", "//": "Create, CreateTemp",
     "match": {"package": "os", "func": "Create*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.write",
     "match": {"package": "os", "func": "Write*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.remove",
     "match": {"package": "os", "func": "Remove*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.mkdir", "//": "Mkdir, MkdirAll, MkdirTemp",
     "match": {"package": "os", "func": "Mkdir*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.rename",
     "match": {"package": "os", "func": "Rename", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.chmod",
     "match": {"package": "os", "func": "Chmod", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.chown",
     "match": {"package": "os", "func": "*Chown", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.truncate",
     "match": {"package": "os", "func": "Truncate", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.link", "//": "Link, Symlink",
     "match": {"package": "os", "func": "*Link", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write"}},
    {"id": "effect.os.file.write", "//": "Write, WriteString, WriteAt on an open *os.File",
     "match": {"package": "os", "recv": "File", "func": "Write*"},
     "emit": {"role": "effect", "kind": "file", "access": "write"}},
    {"id": "effect.os.file.read",
     "match": {"package": "os", "recv": "File", "func": "Read*"},
     "emit": {"role": "effect", "kind": "file", "access": "read"}},
    {"id": "effect.os.file.sync",
     "match": {"package": "os", "recv": "File", "func": "Sync"},
     "emit": {"role": "effect", "kind": "file", "access": "write"}},
    {"id": "effect.os.file.truncate",
     "match": {"package": "os", "recv": "File", "func": "Truncate"},
     "emit": {"role": "effect", "kind": "file", "access": "write"}},
    {"id": "effect.fs.read", "//": "fs.ReadFile, fs.ReadDir, fs.Stat, fs.WalkDir over an fs.FS",
     "match": {"package": "io/fs", "func": "Read*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg1}"}},
    {"id": "effect.fs.stat",
     "match": {"package": "io/fs", "func": "Stat", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg1}"}},
    {"id": "effect.fs.walk",
     "match": {"package": "io/fs", "func": "WalkDir", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg1}"}},
    {"id": "effect.filepath.walk",
     "match": {"package": "path/filepath", "func": "Walk*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg0}"}},
    {"id": "effect.ioutil.read",
     "match": {"package": "io/ioutil", "func": "Read*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "read", "key": "{arg0}"}},
    {"id": "effect.ioutil.write",
     "match": {"package": "io/ioutil", "func": "WriteFile", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write", "key": "{arg0}"}},
    {"id": "effect.ioutil.temp",
     "match": {"package": "io/ioutil", "func": "Temp*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "file", "access": "write"}},

    {"id": "effect.os.getenv", "//": "the key is the variable read",
     "match": {"package": "os", "func": "Getenv", "funcOnly": true},
     "emit": {"role": "effect", "kind": "env", "access": "read", "key": "{arg0}"}},
    {"id": "effect.os.lookupenv",
     "match": {"package": "os", "func": "LookupEnv", "funcOnly": true},
     "emit": {"role": "effect", "kind": "env", "access": "read", "key": "{arg0}"}},
    {"id": "effect.os.expandenv",
     "match": {"package": "os", "func": "ExpandEnv", "funcOnly": true},
     "emit": {"role": "effect", "kind": "env", "access": "read"}},
    {"id": "effect.os.environ",
     "match": {"package": "os", "func": "Environ", "funcOnly": true},
     "emit": {"role": "effect", "kind": "env", "access": "read"}},
    {"id": "effect.os.setenv",
     "match": {"package": "os", "func": "Setenv", "funcOnly": true},
     "emit": {"role": "effect", "kind": "env", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.unsetenv",
     "match": {"package": "os", "func": "Unsetenv", "funcOnly": true},
     "emit": {"role": "effect", "kind": "env", "access": "write", "key": "{arg0}"}},
    {"id": "effect.os.clearenv",
     "match": {"package": "os", "func": "Clearenv", "funcOnly": true},
     "emit": {"role": "effect", "kind": "env", "access": "write"}},
    {"id": "effect.viper.get",
     "match": {"package": "github.com/spf13/viper", "func": "Get*"},
     "emit": {"role": "effect", "kind": "env", "access": "read", "key": "{arg0}"}},
    {"id": "effect.viper.unmarshal",
     "match": {"package": "github.com/spf13/viper", "func": "Unmarshal*"},
     "emit": {"role": "effect", "kind": "env", "access": "read"}},
    {"id": "effect.envconfig",
     "match": {"package": "github.com/kelseyhightower/envconfig", "func": "*Process"},
     "emit": {"role": "effect", "kind": "env", "access": "read", "key": "{arg0}"}},
    {"id": "effect.caarlos0.env",
     "match": {"package": "github.com/caarlos0/env/**", "func": "Parse*"},
     "emit": {"role": "effect", "kind": "env", "access": "read"}},

    {"id": "effect.time.sleep",
     "match": {"package": "time", "func": "Sleep", "funcOnly": true},
     "emit": {"role": "effect", "kind": "time", "key": "{arg0}"}},
    {"id": "effect.time.ticker", "//": "Tick, NewTicker",
     "match": {"package": "time", "func": "*Tick*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "time", "key": "{arg0}"}},
    {"id": "effect.time.timer", "//": "NewTimer, After, AfterFunc",
     "match": {"package": "time", "func": "*Timer", "funcOnly": true},
     "emit": {"role": "effect", "kind": "time", "key": "{arg0}"}},
    {"id": "effect.time.after",
     "match": {"package": "time", "func": "After*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "time", "key": "{arg0}"}},

    {"id": "effect.exec.command", "//": "Command, CommandContext — the key is the program run",
     "match": {"package": "os/exec", "func": "Command*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "process", "key": "{arg0}"}},
    {"id": "effect.exec.run",
     "match": {"package": "os/exec", "recv": "Cmd", "func": "Run"},
     "emit": {"role": "effect", "kind": "process"}},
    {"id": "effect.exec.start",
     "match": {"package": "os/exec", "recv": "Cmd", "func": "Start"},
     "emit": {"role": "effect", "kind": "process"}},
    {"id": "effect.exec.output",
     "match": {"package": "os/exec", "recv": "Cmd", "func": "*Output"},
     "emit": {"role": "effect", "kind": "process"}},
    {"id": "effect.exec.lookpath",
     "match": {"package": "os/exec", "func": "LookPath", "funcOnly": true},
     "emit": {"role": "effect", "kind": "process", "key": "{arg0}"}},
    {"id": "effect.os.exit",
     "match": {"package": "os", "func": "Exit", "funcOnly": true},
     "emit": {"role": "effect", "kind": "process", "key": "{arg0}"}},
    {"id": "effect.os.startprocess",
     "match": {"package": "os", "func": "StartProcess", "funcOnly": true},
     "emit": {"role": "effect", "kind": "process", "key": "{arg0}"}},
    {"id": "effect.os.process.kill",
     "match": {"package": "os", "recv": "Process", "func": "Kill"},
     "emit": {"role": "effect", "kind": "process"}},
    {"id": "effect.os.process.signal",
     "match": {"package": "os", "recv": "Process", "func": "Signal"},
     "emit": {"role": "effect", "kind": "process"}},
    {"id": "effect.log.fatal", "//": "log.Fatal* exits the process",
     "match": {"package": "log", "func": "Fatal*"},
     "emit": {"role": "effect", "kind": "process"}},
    {"id": "effect.signal.notify",
     "match": {"package": "os/signal", "func": "Notify*", "funcOnly": true},
     "emit": {"role": "effect", "kind": "process"}},
    {"id": "effect.syscall.exec",
     "match": {"package": "syscall", "func": "Exec", "funcOnly": true},
     "emit": {"role": "effect", "kind": "process", "key": "{arg0}"}},
    {"id": "effect.syscall.kill",
     "match": {"package": "syscall", "func": "Kill", "funcOnly": true},
     "emit": {"role": "effect", "kind": "process"}}
  ]
}
